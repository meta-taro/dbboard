#!/usr/bin/env sh
#
# dbboard pre-push hook
#
# Installed automatically by cargo-husky on first `cargo test`.
# See CLAUDE.md "Mandatory Verification Commands".

set -e

# GUI git clients (GitHub Desktop, GitKraken, …) launch hooks with a
# minimal PATH that omits the user's cargo install. Add the standard
# rustup location so the hook works regardless of the launching shell.
export PATH="$HOME/.cargo/bin:$PATH"

# Git passes "<local-ref> <local-sha> <remote-ref> <remote-sha>" lines on
# stdin for every ref being pushed. A branch-deletion push sets
# <local-sha> to all zeros; if every line is a deletion there is no code
# to validate, so skip the build/test cycle.
zero_sha="0000000000000000000000000000000000000000"
has_update=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    if [ "$local_sha" != "$zero_sha" ]; then
        has_update=1
    fi
done

if [ "$has_update" = 0 ]; then
    echo "[pre-push] only deletions to push, skipping build/test"
    exit 0
fi

echo "[pre-push] cargo build --release"
cargo build --release

# The libSQL adapter's tests run one at a time. Each opens its own in-memory
# database, and on Windows a parallel run crashes the test binary with
# STATUS_ACCESS_VIOLATION (0xc0000005) after every assertion has already
# passed: the fault is in tearing two databases down at once, not in anything
# under test. Measured on the maintainer's machine, release build: 5 crashes
# in 150 parallel runs, 0 in 150 serialised ones. A coin flip per push is
# worse than a slow test, because it fails a branch that is green and teaches
# whoever hits it to reach for --no-verify. Only this crate is serialised;
# the rest of the workspace keeps its parallelism.
echo "[pre-push] cargo test --all-features --release"
cargo test --all-features --release --workspace --exclude dbboard-turso
cargo test --all-features --release -p dbboard-turso -- --test-threads=1

echo "[pre-push] ok"
