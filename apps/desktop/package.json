{
  "name": "@dbboard/desktop",
  "version": "0.5.1",
  "private": true,
  "description": "dbboard desktop client (Tauri 2 + SvelteKit) over the shared Rust core crates.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
